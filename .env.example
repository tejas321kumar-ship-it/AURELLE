# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string for the AURELLE database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Optional: Razorpay (live payments) ───────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Without these, checkout runs on the built-in demo gateway.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Optional: Shiprocket (live shipping) ─────────────────
# Settings → API → Create API user in your Shiprocket panel.
# Without these, shipments use clearly-labelled demo AWBs.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Optional Shiprocket defaults
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="110001"
# Override only if you're on an API sandbox/region endpoint
# SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
